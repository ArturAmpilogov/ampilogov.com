{"schemaVersion":1,"sourceId":"YA-B1A1ABE2-123","provider":"Яндекс Архив — первичный скан","recordType":"birth-register-surname-family","primaryPersonIds":["P101443","P101856"],"collection":{"catalogId":"b1a1abe2-cf06-4ed6-b459-5de850dbba79","scanNumber":"123","title":"Метрическая книга Параскевинской церкви Кармалки за 1912 год, часть первая, о родившихся"},"links":{"documentUrl":"https://yandex.ru/archive/catalog/b1a1abe2-cf06-4ed6-b459-5de850dbba79/123"},"event":{"type":"birth-and-baptism","recordNumber":12,"date":{"display":"31 января / 4 февраля 1912 года","confidence":"high"},"place":{"asWritten":"село Кармалка","normalized":"Кармалка, Оренбургский уезд","placeId":"karmalka-orenburg"}},"mentions":[{"mentionId":"YA-B1A1ABE2-123-M1","role":"child","personId":"P101856","nameAsTranscribed":"Никифоръ","displayName":"Никифор Сергеевич Ампилогов","surnameSeries":true},{"mentionId":"YA-B1A1ABE2-123-M2","role":"father","personId":"P101443","nameAsTranscribed":"Сергѣй Филипповъ Ампилоговъ","displayName":"Сергей Филиппович Ампилогов","surnameSeries":true},{"mentionId":"YA-B1A1ABE2-123-M3","role":"mother","personId":null,"nameAsTranscribed":"Евфросинья Иванова","displayName":"Евфросиния Ивановна Ампилогова","surnameSeries":false}],"transcription":{"status":"primary-scan-transcription","literal":"№ 12. Января 31 [родился], февраля 4 [крещён]. Никифоръ, въ честь святаго мученика Никифора. Крестьянинъ села Кармалки Михайловской волости Оренбургской губерніи и уѣзда Сергѣй Филипповъ Ампилоговъ и законная жена его Евфросинья Иванова, оба православные. Воспріемники: крестьянинъ села Кармалки Владимиръ Филипповъ Манаевъ и жена крестьянина села Кармалки Анисья Иванова Сѣрыхъ. Священникъ Михаилъ Анциферовъ.","modernInterpretation":"31 января 1912 года в семье Сергея Филипповича Ампилогова и Евфросинии Ивановны родился сын Никифор; крещён 4 февраля.","indexNote":"Внутренний заголовок оригинала даёт 1912 год, вопреки каталожному году Яндекса. Семья Сергея сопоставлена с P101443 по полному имени, Кармалке и имени супруги Евфросинии Ивановны."},"isRecord":true,"cardKind":"named-primary-record","review":{"status":"primary-scan-verified","transcriptionConfidence":"high","unresolved":[]},"evidence":{"publicDisplay":false,"captureType":"vercel-private-original-derived-full-view-with-header-and-enlarged-target","path":"data/genealogy/evidence-private/yandex/b1a1abe2-cf06-4ed6-b459-5de850dbba79/0123-full-view.png","sha256":"731d08bb28d8e0bd5bc50364b39c5b1e927b690bdbb8c686533782f5c3c0e8ac","fragments":[{"kind":"header","path":"data/genealogy/evidence-private/yandex/b1a1abe2-cf06-4ed6-b459-5de850dbba79/0123-header.png","sha256":"649e2548d14373bf158238b6f32efac884775a75294436e4e898c45428d97c19"},{"kind":"target-entry","path":"data/genealogy/evidence-private/yandex/b1a1abe2-cf06-4ed6-b459-5de850dbba79/0123-target-entry.png","sha256":"6249e410ed7768528fc8c67ca5893aa8325913ba1d14aaded4bb999e05bb0135"}],"quality":{"documentOnlyVisuallyConfirmed":true,"siteAndBrowserChromeExcluded":true,"blackDefectsExcluded":true,"targetRowsVisuallyConfirmed":true,"confirmedAt":"2026-09-11"}}}
