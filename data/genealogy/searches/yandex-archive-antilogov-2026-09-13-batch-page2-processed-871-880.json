      "notes": [
        "Отчество Ионов перенесено через строку, окончание и контекст сохранены в крупном фрагменте."
      ]
    },
    {
      "ordinal": 873,
      "canonicalUrl": "https://yandex.ru/archive/catalog/49456752-fc15-4faa-8798-ae451faf353b/141",
      "sourceId": "YA-OGAOO-8381-1-17-141-IVAN-MARRIAGE",
