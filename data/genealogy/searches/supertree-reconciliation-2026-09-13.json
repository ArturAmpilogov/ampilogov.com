    },
    {
      "personIds": [
        "P1363",
        "P1364"
      ],
      "decision": "keep-separate",
      "basis": "Один лист содержит две разные записи №63 и №65 о двух Гликериях, родившихся в один день у разных родителей."
    },
    {
      "personIds": [
        "P1512",
        "P1525"
      ],
      "decision": "keep-separate",
      "basis": "P1525 умер младенцем в июле 1879; P1512 родился у того же отца в ноябре 1879. Повторное имя после смерти ребёнка подтверждается хронологией."
    },
    {
      "personIds": [
        "P1481",
        "P91171"
      ],
      "decision": "keep-separate",
      "basis": "P1481 родилась в 1877 и умерла в 1878; P91171 родилась в 1890 у тех же родителей."
    },
    {
      "personIds": [
        "P1143",
        "P1389"
      ],
      "decision": "keep-separate",
      "basis": "P1143 вступил в брак в 1862 и родился около 1844–1845; P1389 родился около 1856–1857 и впервые женился в 1874."
    }
  ],
