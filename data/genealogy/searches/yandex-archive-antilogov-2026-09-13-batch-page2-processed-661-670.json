      "publicCore": false,
      "personIds": [],
      "notes": [
        "Две независимые ручные читки подтверждают Антипов. Псаломщик Иоанн Смирнов — отдельный участник; профили не создаются."
      ]
    },
    {
      "ordinal": 667,
      "canonicalUrl": "https://yandex.ru/archive/catalog/4bd632f5-990c-4ac7-8cbe-6faf2bd319fe/94",
