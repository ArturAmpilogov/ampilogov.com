      "publicCore": true,
      "personIds": [
        "P101511"
      ],
      "notes": [
        "Профиль переиспользован по полному имени, Гавриловке и устойчивой цепочке актов."
      ]
    },
    {
      "ordinal": 666,
      "canonicalUrl": "https://yandex.ru/archive/catalog/ba84bcee-dcac-460e-b2e4-b23991e7f633/76",
      "sourceId": "YA-BA84BCEE-076-ANTILOGOV-REVIEW",
