*.tsbuildinfo
next-env.d.ts


.playwright-cli

# archive scans: stored in the private Vercel Blob store, kept on disk locally only
# (upload with `pnpm genealogy:evidence:upload`; see src/lib/evidence-store.ts)
/public/archive/evidence
/data/genealogy/evidence-private

# generated by `pnpm genealogy:directory-index` (runs in prebuild/predev)
/data/genealogy/indexes/map-directory.json
/data/genealogy/indexes/people-directory.json
/data/genealogy/indexes/record-source-paths.json
/data/genealogy/indexes/records-directory.json
/data/genealogy/indexes/source-registry.json
