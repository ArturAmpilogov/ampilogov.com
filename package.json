{
  "name": "ampilogov-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm run genealogy:directory-index",
    "dev": "next dev",
    "prebuild": "pnpm run genealogy:directory-index",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "genealogy:index": "node scripts/genealogy/build-familysearch-index.mjs",
    "genealogy:evidence": "node scripts/genealogy/sync-evidence-hashes.mjs",
    "genealogy:evidence-quality": "node scripts/genealogy/sync-evidence-quality.mjs",
    "genealogy:evidence:attach": "node scripts/genealogy/attach-local-evidence.mjs",
    "genealogy:evidence:upload": "node --env-file-if-exists=.env.local scripts/genealogy/upload-evidence-files.mjs",
    "genealogy:evidence:confirm-yandex": "node scripts/genealogy/confirm-yandex-evidence.mjs",
    "genealogy:audit:yandex-evidence": "node scripts/genealogy/audit-yandex-evidence-quality.mjs",
    "genealogy:mentions": "node scripts/genealogy/normalize-mention-ids.mjs",
    "genealogy:names": "node scripts/genealogy/normalize-mention-names.mjs",
    "genealogy:dates": "node scripts/genealogy/normalize-date-displays.mjs --apply",
    "genealogy:reconcile": "node scripts/genealogy/reconcile-new-records.mjs",
    "genealogy:reconcile-russia": "node scripts/genealogy/reconcile-russia-records.mjs",
    "genealogy:audit": "node scripts/genealogy/audit-data-links.mjs",
    "genealogy:audit:records": "node scripts/genealogy/audit-record-integrity.mjs",
    "genealogy:audit:rights": "node scripts/genealogy/audit-public-evidence-rights.mjs",
    "genealogy:normalize:feodor": "node scripts/genealogy/normalize-feodor-public-names.mjs",
    "genealogy:audit:summary": "node scripts/genealogy/audit-data-links.mjs --summary",
    "genealogy:enrich": "node scripts/genealogy/enrich-derived-metadata.mjs",
    "genealogy:enrich:apply": "node scripts/genealogy/enrich-derived-metadata.mjs --apply",
    "genealogy:places": "node scripts/genealogy/link-place-index.mjs",
    "genealogy:yandex-index": "node scripts/genealogy/sync-yandex-archive-index.mjs",
    "genealogy:directory-index": "node scripts/genealogy/build-directory-indexes.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.11.1"
}
